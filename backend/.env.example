# Copy to backend/.env and replace every placeholder. Never commit .env.

# SQLAlchemy URL for the application database (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://car_app:change-me@127.0.0.1:5432/car_dealership

# Separate database used by pytest. Its name MUST end in "_test":
# the test suite drops and recreates all tables in it.
TEST_DATABASE_URL=postgresql+psycopg://car_app:change-me@127.0.0.1:5432/car_dealership_test

# JWT signing key, at least 32 characters (the app refuses to start with
# this placeholder). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
